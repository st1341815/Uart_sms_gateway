# 多设备版本完整构建（含前端）
FROM golang:1.25-alpine AS backend-builder

WORKDIR /build

# 安装依赖（需要 node 来构建前端，注意：web/assets.go 用 go:embed 引用 web/dist，
# 前端不构建会导致 go build 失败，所以这里必须真的构建前端）
RUN apk add --no-cache git nodejs npm

# 复制 go 模块文件
COPY go.mod go.sum ./
RUN go mod download

# 复制源代码
COPY . .

# 构建前端（产物 web/dist 会被 go:embed 打进二进制）
RUN cd web && npm ci && npm run build

# 编译后端
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o uart_sms_forwarder ./cmd/serv

# 最终镜像
FROM alpine:latest

RUN apk add --no-cache ca-certificates tzdata wget || true

WORKDIR /app

# 复制后端程序
COPY --from=backend-builder /build/uart_sms_forwarder .
COPY config.example.yaml ./config.example.yaml

# 创建数据目录
RUN mkdir -p /app/data /app/logs
RUN chmod +x ./uart_sms_forwarder

HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:8080/health || exit 1

CMD ["./uart_sms_forwarder"]
