config.yaml

# OS
.DS_Store

# web/dist 入库（2026-11-01 决定）
# 原因：web/assets.go 用 go:embed 引用前端产物，若 dist 不入库，
#       干净 clone 后必须装 node 才能 go build。
# 代价：每次改前端都要把 dist 一起提交（仓库多约 600 KB）。
# 注意：node_modules 仍然忽略，不要提交。
.release-bin/
dist-release/
