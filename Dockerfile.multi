# Dockerfile for uart_sms_forwarder-multi
# 多设备版本 - 简化构建
#
# ⚠️ 前端可以选择预构建
#   WEB_PREBUILT=1（默认）：直接用仓库里的 web/embed_dir，容器内不装 node。
#                           适用于调用方已经跑过 `npm run build` 并同步了产物。
#   WEB_PREBUILT=0          ：容器内 apk add nodejs/npm + npm ci + build。
#
#   本地直接构建（没有预构建产物）时显式关掉：
#     docker build -f Dockerfile.multi --build-arg WEB_PREBUILT=0 -t <tag> .
#
# 国内网络注意：默认的 proxy.golang.org / registry.npmjs.org 在部分环境不通
# （2026-11-03 在部署机上实测：proxy.golang.org 直接 EOF），所以默认用国内源，
# 需要时用 build-arg 覆盖：
#   docker build -f Dockerfile.multi \
#     --build-arg GOPROXY=https://proxy.golang.org,direct \
#     --build-arg NPM_REGISTRY=https://registry.npmjs.org \
#     -t <tag> .

FROM golang:1.25-alpine AS builder
WORKDIR /build

ARG GOPROXY=https://goproxy.cn,direct
ARG NPM_REGISTRY=https://registry.npmmirror.com
# 1 = 使用调用方已构建好的 web/embed_dir（CI 路径，快）
# 0 = 在容器内 apk add nodejs/npm 并构建前端（本地路径，慢）
ARG WEB_PREBUILT=1
ENV GOPROXY=${GOPROXY}

COPY go.mod go.sum ./
RUN go mod download
COPY . .

# web/assets.go 用 go:embed 嵌的是 web/embed_dir（不是 web/dist！），
# 所以无论哪种路径，构建结束后 embed_dir 都必须是「最新产物」。
RUN set -e; \
    if [ "$WEB_PREBUILT" = "1" ]; then \
        test -f /build/web/embed_dir/index.html || { \
            echo "::error::WEB_PREBUILT=1 但 web/embed_dir/index.html 不存在（CI 应先生成前端产物）"; exit 1; }; \
        echo "→ 使用预构建前端 web/embed_dir（跳过容器内 npm 构建）"; \
    else \
        echo "→ 容器内构建前端（WEB_PREBUILT=0）"; \
        sed -i 's#https://dl-cdn.alpinelinux.org#https://mirrors.aliyun.com#g' /etc/apk/repositories; \
        timeout 180 apk add --no-cache git nodejs npm; \
        npm config set registry "$NPM_REGISTRY"; \
        cd /build/web && npm ci && npm run build; \
        rm -rf /build/web/embed_dir && cp -a /build/web/dist /build/web/embed_dir; \
    fi

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o uart_sms_forwarder ./cmd/serv

FROM alpine:latest
# 换国内 apk 源 + 超时兜底：dl-cdn.alpinelinux.org 在本机被 DNS 解析到 fake-ip 段
# （198.18.0.144，RFC2544 保留段），实测下载只有 20KB/s，容器内 apk add 会静默卡死
# 5~10 分钟、零输出。镜像换 aliyun（实测 1.1MB/s），timeout 兜底避免再次挂起。
RUN sed -i 's#https://dl-cdn.alpinelinux.org#https://mirrors.aliyun.com#g' /etc/apk/repositories \
 && timeout 60 apk add --no-cache ca-certificates tzdata || true
WORKDIR /app
COPY --from=builder /build/uart_sms_forwarder .
COPY --from=builder /build/config.example.yaml ./config.example.yaml
RUN mkdir -p /app/data /app/logs
RUN chmod +x ./uart_sms_forwarder
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:8080/health || exit 1
CMD ["./uart_sms_forwarder"]
