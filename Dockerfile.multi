# Dockerfile for uart_sms_forwarder-multi
# 多设备版本 - 简化构建

FROM golang:1.25-alpine AS builder
WORKDIR /build
# web/assets.go 用 go:embed 嵌的是 web/embed_dir（不是 web/dist！），
# 所以构建前端后必须把它同步到 embed_dir，否则二进制里打进的是仓库里的旧产物。
RUN apk add --no-cache git nodejs npm
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN cd web && npm ci && npm run build \
 && rm -rf /build/web/embed_dir && cp -a /build/web/dist /build/web/embed_dir
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o uart_sms_forwarder ./cmd/serv

FROM alpine:latest
RUN apk add --no-cache ca-certificates tzdata || true
WORKDIR /app
COPY --from=builder /build/uart_sms_forwarder .
COPY --from=builder /build/config.example.yaml ./config.example.yaml
RUN mkdir -p /app/data /app/logs
RUN chmod +x ./uart_sms_forwarder
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:8080/health || exit 1
CMD ["./uart_sms_forwarder"]
